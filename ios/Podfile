# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Resolve firebase-ios-sdk through CocoaPods instead of Swift Package Manager.
# Must be set before any target block.
#
# @react-native-firebase v23+ defaults to pulling Firebase in over SPM, and
# firebase-ios-sdk's SPM products are *automatic* libraries (plain
# `.library(...)`, not `type: .dynamic`), so every RNFB pod statically embeds
# its own copy of Firebase. Under static pod linkage those copies collide and
# `pod install` refuses to continue:
#
#   [react-native-firebase] SPM + static linkage is not supported (target(s): Pods-Smart)
#
# Note this is NOT limited to `use_frameworks! :linkage => :static`, despite
# what that message suggests. RNFB's check is on
# `target_definition.build_type.static?`, which is also true for the plain
# static-library default this project uses when USE_FRAMEWORKS is unset — so
# the failure happens on a completely stock install.
#
# The alternative fix RNFB offers is `use_frameworks! :linkage => :dynamic`,
# which is rejected here: it changes linkage for *every* pod in a project that
# already carries workarounds for exactly this class of problem (modular
# headers for GoogleSignIn and react-native-app-auth, the fmt C++17 override
# below), and Hermes plus the New Architecture add more surface. Opting out of
# SPM is the surgical change — it touches only how Firebase is resolved and
# leaves every other pod exactly as it builds today.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
  # Only read when use_frameworks! is on (the podspecs check `defined?`, not the
  # value, so it must stay inside this block). Firebase ships static binaries;
  # building the RNFB pods as static frameworks is the documented pairing and
  # avoids duplicate-symbol and "class implemented in both" failures.
  $RNFirebaseAsStaticFramework = true
end

target 'Smart' do
  config = use_native_modules!

  # RN's own react_native_pods.rb only sets :modular_headers on React's own
  # pods, so these two third-party pods otherwise build as plain static
  # libraries with no module map — Swift's `import react_native_app_auth` /
  # `import GoogleSignIn` in AppDelegate.swift then fails with "No such
  # module". Forcing modular headers here gives them one.
  pod 'react-native-app-auth', :path => '../node_modules/react-native-app-auth', :modular_headers => true
  pod 'GoogleSignIn', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end