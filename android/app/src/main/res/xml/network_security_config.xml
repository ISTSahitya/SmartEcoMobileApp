<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Device provisioning no longer uses the 192.168.4.1 / esp32.local hotspot HTTP
         endpoint (replaced by BLE). Only local dev hosts remain. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.0.194</domain>
    </domain-config>
</network-security-config>